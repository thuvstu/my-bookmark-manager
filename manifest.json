{
  "manifest_version": 3,
  "name": "Browser Cleaner & YT Manager Pro",
  "version": "4.0.0",
  "description": "ブラウザ掃除・YouTube管理・タブ管理・ブックマークツール",
  "permissions": [
    "bookmarks",
    "history",
    "readingList",
    "downloads",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "url-cleaner.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "quick-backup": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "クイックバックアップ"
    },
    "save-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "タブを保存"
    }
  }
}