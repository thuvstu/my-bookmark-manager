{
  "manifest_version": 3,
  "name": "Bookmark Suite",
  "version": "5.0.0",
  "description": "ブックマーク統合スイート: フルエディタ / マージ・最適化、バックアップ掃除、YouTube高評価コレクター、URL浄化",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Suite",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "permissions": [
    "bookmarks",
    "history",
    "readingList",
    "downloads",
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "url-cleaner.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "yt-collector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "quick-backup": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "クイックバックアップ"
    },
    "save-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "タブを保存"
    },
    "open-editor": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Bookmark Suite エディタを開く"
    }
  }
}
